---
---
[
{%- for doc in site.documents %}
  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "section": {{ doc.collection | jsonify }},
    "tags": [{% for t in doc.tags %}{{ t | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "content": {{ doc.content | strip_html | normalize_whitespace | truncate: 4000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
